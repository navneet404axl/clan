# --- Clash of Clans API ---
# Get a token at https://developer.clashofclans.com (log in, create a key,
# and whitelist it to the IP your server runs from).
COC_API_TOKEN=

# Your clan tag, including the leading # (e.g. #ABC123).
COC_CLAN_TAG=

# Optional: override the API base URL to route through a fixed-IP proxy in prod
# (one way around the API's IP whitelist on dynamic-IP hosts).
# COC_BASE_URL=https://api.clashofclans.com/v1

# --- Database ---
# Postgres connection string (local, Neon, Supabase, ...).
DATABASE_URL=postgresql://user:password@localhost:5432/clan
